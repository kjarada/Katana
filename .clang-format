BasedOnStyle: LLVM
Language: Cpp
Standard: c++20
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
# Functions open on their own line; classes, namespaces and control flow attach.
BreakBeforeBraces: WebKit
AccessModifierOffset: -2
AlignAfterOpenBracket: Align
AllowShortFunctionsOnASingleLine: Inline
NamespaceIndentation: None
PointerAlignment: Left
SortIncludes: true
IncludeBlocks: Preserve
