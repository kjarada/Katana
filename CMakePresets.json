{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "release",
            "displayName": "Test runner (Windows, MSYS2 UCRT64 on PATH)",
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "environment": {
                "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Test runner (Linux)",
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "macos-release",
            "displayName": "Test runner (macOS)",
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        }
    ],
    "buildPresets": [
        { "name": "release", "configurePreset": "release" },
        { "name": "linux-release", "configurePreset": "linux-release" },
        { "name": "macos-release", "configurePreset": "macos-release" }
    ],
    "testPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release",
            "output": { "outputOnFailure": true }
        }
    ]
}
