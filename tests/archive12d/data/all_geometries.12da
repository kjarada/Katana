// ---------------------------------------------------------------------------
// comprehensive-all-geometries.12da
//
// A hand-written, self-contained 12da fixture that exercises EVERY geometry
// type the viewer supports, with rich nested attributes on each feature.
// Used for manual QA and automated parser round-trip tests.
//
// Coordinates are MGA2020 Zone 56 (Brisbane area).  Confirm the CRS in the
// UI as "MGA2020 / Zone 56" to see everything placed on the Leaflet map,
// or load with "Unknown / arbitrary" to inspect geometry without a CRS.
//
// Geometry coverage:
//   - Individual points     (breakline-point strings, 1 point each)
//   - Polylines             (open strings, multiple vertices)
//   - Polygons              (closed strings, closed = 1)
//   - Super alignment       (horizontal_data + vertical_data coord polylines,
//                            geometry_data arc segment)
//   - TIN surface           (full_tin with points + triangle indices)
//   - Trimesh               (primitive_3d -> trimesh_3d with vertices + faces)
//   - Text labels           (single-line `text "label" E N Z` form)
//   - Arc string            (centre + start + end keyword form)
//   - Circle string         (centre + radius keyword form)
//   - Feature string        (centre + radius keyword form)
//   - Interface string      (data rows with trailing cut/fill mode column)
//   - Polyline string       (superseded; x y z radius bulge rows with an arc)
//   - 4d string             (superseded; x y z "text" rows -> text entities)
//   - Alignment string      (superseded; hipdata/vipdata IP definitions)
//   - Pipeline string       (superseded; alignment + diameter)
//   - Drainage string       (data + pit/pipe sub-blocks -> pit markers)
//   - Plot frame            (sheet rectangle from origin/size/scale)
//   - LAS cloud             (points_v10_p0 tagged + compact point records)
//   - Curved super string   (data_2d + geometry_data arc densification)
//
// Attribute coverage per feature:
//   - Nested `group { ... }` hierarchies (mix of text / real / integer)
//   - Shallow top-level attribute lists
// ---------------------------------------------------------------------------

// archive_version "15.01.08.60"
// decimal_places 3
// null -999
// null_keyword true

// ---------------------------------------------------------------------------
//  Model: Survey Control — three individual permanent-mark points
// ---------------------------------------------------------------------------
// A hand-written 12da inherits the format's CURRENT BREAKLINE TYPE, whose
// default is `point` (commands, 1.4.4), and `breakline point` means the
// string's vertices are separate POINTS rather than a line through them. 12d
// writes the flag on every string it exports and leaves nothing to the
// default; this says it once for the strings below that do not, so that a
// string meaning a line is read as one. A string that wants points overrides
// it with `breakline point` of its own.
breakline line
model "Survey Control"

string super {
  name      "PM001 Permanent Mark"
  chainage  0
  breakline point
  colour    red
  style     "PermanentMark"

  attributes {
    group {
      name "Identification"
      attributes {
        text    "AssetIdentifier"   "PM-BN-001"
        text    "AssetType"         "Permanent Mark"
        text    "AssetOwner"        "Queensland Cadastre"
      }
    }
    group {
      name "SurveyData"
      attributes {
        real    "ReducedLevel"       32.451
        text    "Datum"              "AHD"
        text    "DateEstablished"    "2024-09-14"
        integer "OrderOfAccuracy"    2
      }
    }
    text    "Remarks"   "Brass plate in concrete footpath; adjacent to street tree."
  }
  closed 0
  data_3d {
    502000.000 6960000.000 32.451
  }
}

string super {
  name      "PM002 Permanent Mark"
  chainage  0
  breakline point
  colour    red
  style     "PermanentMark"

  attributes {
    group {
      name "Identification"
      attributes {
        text    "AssetIdentifier"   "PM-BN-002"
        text    "AssetType"         "Permanent Mark"
        text    "AssetOwner"        "Queensland Cadastre"
      }
    }
    group {
      name "SurveyData"
      attributes {
        real    "ReducedLevel"       34.112
        text    "Datum"              "AHD"
        integer "OrderOfAccuracy"    3
      }
    }
  }
  closed 0
  data_3d {
    502250.000 6960125.000 34.112
  }
}

string super {
  name      "BM003 Church Benchmark"
  chainage  0
  breakline point
  colour    yellow
  style     "Benchmark"

  attributes {
    text    "AssetIdentifier"   "BM-CHURCH-01"
    text    "AssetType"         "Benchmark"
    real    "ReducedLevel"      36.008
    text    "Remarks"           "Church foundation corner stone"
  }
  closed 0
  data_3d {
    502480.000 6960280.000 36.008
  }
}

