// The Windows resource of katana.exe: its icon and its version information.
//
// The icon is what Explorer, the taskbar and Alt-Tab show for the FILE, before
// any Qt code has run; QApplication::setWindowIcon covers the running windows
// but not the executable on disk. Windows takes the first icon resource in the
// file, which is why this one has the lowest id.
//
// The version block is what the file's Properties > Details tab shows, what an
// installer compares to decide whether to replace a file, and what a crash
// report names. The numbers come from project(Katana VERSION ...) in the root
// CMakeLists.txt, so there is one place a version is ever written.

#include <winver.h>

IDI_ICON1 ICON "@KATANA_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = US English, 04b0 = Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Katana"
            VALUE "FileDescription",  "Katana - survey and CAD platform"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "katana"
            VALUE "OriginalFilename", "katana.exe"
            VALUE "ProductName",      "Katana"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
