# Makes an installed Linux or macOS tree self-contained: every library the
# programs load that comes from the toolchain prefix
# (tools/setup_linux_toolchain.py - conda-forge's GDAL, PDAL, PROJ, SQLite,
# libcurl and the C++ runtime the native shims link), copied into lib/, the
# programs' run-time path pointed at it, and the data GDAL, PROJ and libcurl
# read at run time. The Unix counterpart of KatanaDeploy.cmake.in, run by
# `cmake --install` (and so by the `bundle` and `package` targets). Configured
# by cmake/KatanaPackaging.cmake with @ONLY: every ${...} is evaluated when the
# script RUNS and every @...@ at configure time.
#
# The tree MIRRORS the toolchain prefix, which is what makes it work:
#
#   bin/katana, katana_cli, katana_mcp   run-time path $ORIGIN/../lib, set below
#       katana_updater (Linux only)      (cargo links them with the prefix's lib/)
#   lib/*.so* or *.dylib                 as in the prefix, where each library's
#                                        own run-time path ($ORIGIN, @loader_path)
#                                        already finds the others
#   share/proj, share/gdal               found beside libproj and libgdal
#   ssl/cacert.pem                       found beside libcurl (katana_core's
#                                        library_data)
#
# On macOS the tree is Katana.app, with the same relative layout under
# Contents under Apple's names, because code signing seals a bundle only
# when code and data are where it expects them:
#
#   Contents/Info.plist                  what Finder reads: the program, the icon
#   Contents/MacOS/katana, ...           bin/, run-time path @loader_path/../Frameworks
#   Contents/Frameworks/                 lib/
#   Contents/Resources/share, ssl        the data, found beside Frameworks
#   Contents/Resources/katana.icns       the icon, made here from katana.png
#
# Why not the distribution's libraries: the libraries the crates are built
# against - PROJ 9.5 or later among them, which no long-term-support
# distribution ships (docs/building.md, "Linux") - exist only in the toolchain
# prefix, and a tree that borrowed them from there would run only on the
# machine that built it.
#
# Until 2026-11-15 this also copied Qt's plugins and wrote qt.conf, and the
# programs' run-time path came from CMake's install(TARGETS). The window is
# egui and wgpu now, which load only the system's graphics and windowing
# libraries, and the programs are cargo's, installed as files: their run-time
# path is rewritten here (step 4).

if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()

set(_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_bin "${_prefix}/@KATANA_INSTALL_BINDIR@")
set(_bundle "@KATANA_APP_BUNDLE@")
if(_bundle)
    set(_contents "${_prefix}/${_bundle}/Contents")
    set(_lib "${_contents}/Frameworks")
    set(_data "${_contents}/Resources")
    set(_runpath "@loader_path/../Frameworks")
else()
    set(_lib "${_prefix}/lib")
    set(_data "${_prefix}")
    set(_runpath "$ORIGIN/../lib")
endif()
set(_toolchain "@KATANA_TOOLCHAIN_PREFIX@")
set(_programs "@KATANA_PROGRAMS@")
set(_apple "@APPLE@")

# Libraries that belong to the machine it RUNS on, never shipped, though the
# toolchain prefix has copies: the C library (a copy of it cannot be loaded
# beside the system's), the graphics driver's GL, EGL and Vulkan loaders, and
# the X11 and font-configuration libraries, whose configuration files are
# found by a path compiled in for the toolchain prefix. The set follows
# AppImage's excludelist (github.com/AppImageCommunity/pkg2appimage,
# "excludelist"), for the same reasons. Every Linux desktop has them.
set(_system_libraries
    "^ld-linux" "^libc\\.so" "^libm\\.so" "^libmvec\\.so" "^libdl\\.so" "^libpthread\\.so"
    "^librt\\.so" "^libutil\\.so" "^libresolv\\.so" "^libanl\\.so"
    "^libGL\\.so" "^libGLX\\.so" "^libEGL\\.so" "^libOpenGL\\.so" "^libGLdispatch\\.so"
    "^libGLESv2\\.so" "^libdrm\\.so" "^libgbm\\.so" "^libvulkan\\.so"
    "^libX11\\.so" "^libX11-xcb\\.so" "^libxcb\\.so" "^libfontconfig\\.so" "^libfreetype\\.so")

# --- 1. Every library they load ----------------------------------------------------
# What is scanned is cargo's programs in KATANA_PROGRAMS, not the copies just
# installed: those still carry the run-time path naming the prefix's lib/, so
# every dependency resolves the way the loader resolves it. katana_updater is
# the fourth: installed on Linux only (macOS updating is check-and-notify,
# cmake/KatanaPackaging.cmake), so on macOS the EXISTS test below skips it. A
# program named nowhere in this list is installed with its libraries not
# copied; tools/check_install_rules.cmake holds this one line to the programs
# that are installed.
set(_executables "")
foreach(_program katana katana_cli katana_mcp katana_updater)
    if(EXISTS "${_bin}/${_program}" AND EXISTS "${_programs}/${_program}")
        list(APPEND _executables "${_programs}/${_program}")
    endif()
endforeach()

file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${_executables}
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    CONFLICTING_DEPENDENCIES_PREFIX _conflict
    DIRECTORIES "${_toolchain}/lib"
    POST_EXCLUDE_REGEXES "^/usr/lib/" "^/System/" "^/lib/" "^/lib64/" "^/usr/lib64/")

foreach(_name IN LISTS _conflict_FILENAMES)
    list(GET _conflict_${_name} 0 _first)
    list(APPEND _resolved "${_first}")
endforeach()

file(MAKE_DIRECTORY "${_lib}" "${_data}/ssl")
set(_copied 0)
foreach(_dependency IN LISTS _resolved)
    # Only what came from the toolchain; anything else resolved is the
    # operating system's.
    file(REAL_PATH "${_dependency}" _real)
    if(NOT _real MATCHES "^${_toolchain}/" AND NOT _dependency MATCHES "^${_toolchain}/")
        continue()
    endif()
    get_filename_component(_name "${_dependency}" NAME)
    set(_skip FALSE)
    foreach(_pattern IN LISTS _system_libraries)
        if(_name MATCHES "${_pattern}")
            set(_skip TRUE)
        endif()
    endforeach()
    if(_skip OR EXISTS "${_lib}/${_name}")
        continue()
    endif()
    # Under the name the loader asks for (the soname, libfoo.so.1), with the
    # contents of the file the symbolic link chain ends at.
    file(COPY_FILE "${_real}" "${_lib}/${_name}")
    math(EXPR _copied "${_copied} + 1")
endforeach()
message(STATUS "Katana deploy: ${_copied} runtime libraries copied into ${_lib}")

# Unresolved names that are the system's are expected (the scan does not look
# in /usr/lib for a program whose run-time path does not name it); anything
# else is a tree that starts here and fails elsewhere, so it is named now.
set(_missing "")
foreach(_name IN LISTS _unresolved)
    set(_expected FALSE)
    foreach(_pattern IN LISTS _system_libraries)
        if(_name MATCHES "${_pattern}")
            set(_expected TRUE)
        endif()
    endforeach()
    if(NOT _expected AND NOT _name MATCHES "^/usr/lib/|^/System/")
        list(APPEND _missing "${_name}")
    endif()
endforeach()
if(_missing)
    list(JOIN _missing "\n  " _text)
    message(WARNING "Katana deploy: these dependencies were NOT found and are not bundled:\n  ${_text}")
endif()

# --- 2. Data read at run time -------------------------------------------------------
foreach(_set proj gdal)
    if(IS_DIRECTORY "${_toolchain}/share/${_set}")
        file(COPY "${_toolchain}/share/${_set}" DESTINATION "${_data}/share")
    elseif(_set STREQUAL "proj")
        # A bundle without proj.db cannot name a coordinate system, and the smoke
        # test of INFO on a UTM raster would not notice (docs/release.md).
        message(FATAL_ERROR "Katana deploy: ${_toolchain}/share/proj was not found; "
                            "a bundle without PROJ's database cannot be made")
    else()
        message(WARNING "Katana deploy: ${_toolchain}/share/${_set} was not found; "
                        "the bundle will lack it")
    endif()
endforeach()
if(NOT EXISTS "${_data}/share/proj/proj.db")
    message(FATAL_ERROR "Katana deploy: ${_data}/share/proj/proj.db is not in the bundle; "
                        "the toolchain's share/proj holds no proj.db")
endif()
if(EXISTS "${_toolchain}/ssl/cacert.pem")
    file(COPY_FILE "${_toolchain}/ssl/cacert.pem" "${_data}/ssl/cacert.pem")
else()
    message(WARNING "Katana deploy: ${_toolchain}/ssl/cacert.pem was not found; "
                    "no https:// request will be trusted")
endif()

# --- 3. macOS: what makes Katana.app an application ------------------------------------
if(_bundle AND EXISTS "${_bin}/katana")
    file(COPY_FILE "@CMAKE_BINARY_DIR@/Info.plist" "${_contents}/Info.plist")
    # The icon, from the same 256-pixel image the window uses: an icon set at
    # the sizes Finder and the Dock ask for, compiled by iconutil. No size
    # above the source's is made - an upscaled icon is only a blurred one.
    set(_iconset "@CMAKE_BINARY_DIR@/katana.iconset")
    file(REMOVE_RECURSE "${_iconset}")
    file(MAKE_DIRECTORY "${_iconset}")
    foreach(_icon "16x16:16" "16x16@2x:32" "32x32:32" "32x32@2x:64" "128x128:128"
                  "128x128@2x:256" "256x256:256")
        string(REPLACE ":" ";" _icon "${_icon}")
        list(GET _icon 0 _name)
        list(GET _icon 1 _pixels)
        execute_process(COMMAND sips -z ${_pixels} ${_pixels} "@KATANA_ROOT@/resources/katana.png"
                                --out "${_iconset}/icon_${_name}.png"
            RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_VARIABLE _err)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "sips could not make the ${_name} icon (${_rc}): ${_err}")
        endif()
    endforeach()
    execute_process(COMMAND iconutil -c icns "${_iconset}" -o "${_data}/katana.icns"
        RESULT_VARIABLE _rc ERROR_VARIABLE _err)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "iconutil could not make katana.icns (${_rc}): ${_err}")
    endif()
endif()

# --- 4. The installed programs' run-time path -------------------------------------------
# cargo links each program with the prefix's lib/ as its run-time path
# (-Wl,-rpath,<prefix>/lib, from tools/build_visible.sh and the release jobs),
# which is what lets the tests and the scan above find GDAL without
# LD_LIBRARY_PATH. An installed copy must find the lib/ beside it instead, and
# must not name a folder of the machine that built it: an absolute run-time
# path to a folder that does not exist on the user's machine is one that
# anybody who can make that folder decides the libraries of. So the prefix's
# entry is replaced by the relative one. On Linux in place, by CMake's own ELF
# editor (file(RPATH_CHANGE), which install(TARGETS) uses; the new path is
# shorter than the prefix's, as the editor needs); on macOS by
# install_name_tool, whose change also invalidates the signature that step 5
# makes again. An entry that is not there stops the package: the programs were
# then built without the prefix's run-time path, and the scan above found
# their libraries by its DIRECTORIES alone.
foreach(_name katana katana_cli katana_mcp katana_updater)
    if(NOT EXISTS "${_bin}/${_name}")
        continue()
    endif()
    if(_apple)
        execute_process(COMMAND install_name_tool -rpath "${_toolchain}/lib" "${_runpath}" "${_bin}/${_name}"
            RESULT_VARIABLE _rc ERROR_VARIABLE _err)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "install_name_tool could not point ${_name} at ${_runpath} in place of "
                                "${_toolchain}/lib (${_rc}): ${_err}")
        endif()
    else()
        file(RPATH_CHANGE FILE "${_bin}/${_name}" OLD_RPATH "${_toolchain}/lib" NEW_RPATH "${_runpath}")
    endif()
endforeach()
message(STATUS "Katana deploy: the programs' run-time path is ${_runpath}")

# --- 5. macOS: a signature that matches ------------------------------------------------
# Apple silicon refuses to run code whose signature does not match it, and
# step 4 has just rewritten the programs' load commands after the linker
# signed them. Ad hoc, as the linker did: a distributable signature needs a
# Developer ID, which the build does not have (cmake/KatanaSign.cmake applies
# one when packaging, if there is one).
#
# In a bundle, every library is signed afresh too, and the bundle last: sealing
# it records each nested library's signature and every resource's hash, and
# refuses a library whose signature the copy left stale.
function(_katana_sign_ad_hoc)
    execute_process(COMMAND codesign --force --sign - ${ARGN}
        RESULT_VARIABLE _rc ERROR_VARIABLE _err)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "codesign ${ARGN} failed (${_rc}): ${_err}")
    endif()
endfunction()
if(_apple)
    if(_bundle AND EXISTS "${_bin}/katana")
        file(GLOB_RECURSE _libraries "${_lib}/*.dylib" "${_lib}/*.so")
        set(_real_libraries "")
        foreach(_library IN LISTS _libraries)
            if(NOT IS_SYMLINK "${_library}")
                list(APPEND _real_libraries "${_library}")
            endif()
        endforeach()
        if(_real_libraries)
            _katana_sign_ad_hoc(${_real_libraries})
        endif()
    endif()
    # The programs the bundle's own executable is not, then the bundle, which
    # signs its executable (katana) with the Info.plist bound to it.
    foreach(_name katana_cli katana_mcp katana)
        if(EXISTS "${_bin}/${_name}" AND NOT (_bundle AND _name STREQUAL "katana"))
            _katana_sign_ad_hoc("${_bin}/${_name}")
        endif()
    endforeach()
    if(_bundle AND EXISTS "${_bin}/katana")
        _katana_sign_ad_hoc("${_prefix}/${_bundle}")
    endif()
endif()
