# Makes a Windows bin/ directory self-contained: Qt, GDAL, PDAL, PROJ, the C++
# runtime and every DLL they load, beside the programs, and the data GDAL and
# PROJ read at run time in ../share. Configured with @ONLY, so every ${...}
# here is evaluated when the script RUNS and every @...@ at configure time.
#
# ONE script, run two ways, so the bundle and the build cannot disagree about
# what a self-contained Katana needs:
#
#   by `cmake --install` (install(SCRIPT), and so by the `bundle` target and
#   CPack) - into the install prefix, a fresh tree, every time;
#
#   by each program after linking, and by the katana_runtime target,
#   with -DKATANA_DEPLOY_PREFIX=<build dir> - so that <build>/bin/katana.exe
#   runs on its own, with no MSYS2 on PATH. That run is INCREMENTAL: a full
#   deploy of the Release tree took 36 s on an idle machine and 62-85 s beside
#   another build (measured 2026-09-23; the dependency scan is most of it),
#   which no build can pay every time. The check that skips it took 0-1 s.

cmake_minimum_required(VERSION 3.24)

# CMake 4.1 made file(GET_RUNTIME_DEPENDENCIES) normalise paths before matching
# them (CMP0207). NEW is what the exclusion regexes below are written for -
# forward slashes - and a script starts with no policies set, so without this
# every system DLL raises a policy warning of its own.
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()

if(DEFINED KATANA_DEPLOY_PREFIX)
    get_filename_component(_prefix "${KATANA_DEPLOY_PREFIX}" ABSOLUTE)
    set(_build_tree TRUE)
else()
    set(_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
    set(_build_tree FALSE)
endif()
set(_bin "${_prefix}/bin")
if(DEFINED KATANA_DEPLOY_BIN)
    get_filename_component(_bin "${KATANA_DEPLOY_BIN}" ABSOLUTE)
endif()
set(_toolchain_bin "@KATANA_RUNTIME_BIN@")
set(_qt_plugins "@KATANA_QT_PLUGIN_DIR@")

# A POST_BUILD invocation reads only its just-linked executable: another
# program may still be linking. The lock also protects the shared DLLs and stamp.
if(_build_tree)
    file(MAKE_DIRECTORY "${_prefix}/CMakeFiles")
    file(LOCK "${_prefix}/CMakeFiles/katana_runtime.lock"
         GUARD PROCESS RESULT_VARIABLE _lock_result)
    if(NOT "${_lock_result}" STREQUAL "0")
        message(FATAL_ERROR "Katana runtime: could not lock ${_bin}: ${_lock_result}")
    endif()
endif()
set(_executables "")
if(DEFINED KATANA_DEPLOY_EXECUTABLE)
    list(APPEND _executables "${KATANA_DEPLOY_EXECUTABLE}")
else()
    foreach(_program IN ITEMS @_katana_bundle_targets@)
        list(APPEND _executables "${_bin}/${_program}.exe")
    endforeach()
endif()
if(NOT _executables)
    message(FATAL_ERROR "Katana deploy: no programs were configured for deployment")
endif()
set(_program_names "")
set(_program_records "")
foreach(_executable IN LISTS _executables)
    if(NOT EXISTS "${_executable}")
        message(FATAL_ERROR "Katana deploy: ${_executable} does not exist; build the program before deploying it")
    endif()
    get_filename_component(_name "${_executable}" NAME)
    list(APPEND _program_names "${_name}")
    file(TIMESTAMP "${_executable}" _time "%s.%f" UTC)
    file(SIZE "${_executable}" _size)
    list(APPEND _program_records "program=${_name}|${_time}|${_size}")
endforeach()

# DLLs under bin/ that the deploy owns. The build tree's bin/ also holds the
# test and benchmark programs in subdirectories; they are run with the
# toolchain on PATH (KatanaTargetDefaults.cmake) and are not shipped, so their
# directories are left alone.
function(_katana_deployed_dlls out)
    file(GLOB_RECURSE _all RELATIVE "${_bin}" "${_bin}/*.dll")
    list(FILTER _all EXCLUDE REGEX "^(tests|benchmarks)/")
    set(${out} "${_all}" PARENT_SCOPE)
endfunction()

# Where a deployed DLL came from: a top-level one from the toolchain, one in a
# subdirectory (a Qt plugin) from Qt's plugin directory. Empty when neither has
# it. Asked of the file's NAME, because windeployqt, which copies most of Qt,
# does not report its sources.
function(_katana_source_of relative out)
    set(${out} "" PARENT_SCOPE)
    if(relative MATCHES "/")
        if(NOT _qt_plugins STREQUAL "" AND EXISTS "${_qt_plugins}/${relative}")
            set(${out} "${_qt_plugins}/${relative}" PARENT_SCOPE)
        endif()
    elseif(EXISTS "${_toolchain_bin}/${relative}")
        set(${out} "${_toolchain_bin}/${relative}" PARENT_SCOPE)
    endif()
endfunction()

# --- 0. The build tree: is the last deploy still right? ------------------------------
# It is when the inputs, the programs and the deployed files are unchanged:
#
#  - the key is unchanged. It is a hash of every module's link libraries,
#    computed at configure time (KatanaPackaging.cmake): which third-party
#    DLLs are needed can change when a link line does.
#  - each requested program has been scanned since it was linked. A target
#    built later must not trust the earlier target's smaller dependency set;
#    new code can also use a previously unused import library without a
#    change to the link line.
#  - every DLL that deploy recorded is still there.
#  - every one of them is the toolchain's CURRENT copy. MSYS2 is a rolling
#    toolchain (GCC moved 15.2 -> 16.2 on 2026-09-21): an update replaces
#    libstdc++-6.dll under the same name, and a program relinked against the
#    new one but finding the old one beside itself fails to start with "entry
#    point not found". file(COPY) keeps the source's timestamp, so a
#    different timestamp is a different file.
#
# Anything else is a full deploy, which re-copies what changed (file(COPY)
# skips a file whose timestamp already matches) and rescans for what is new.
set(_stamp "${_prefix}/CMakeFiles/katana_runtime.stamp")
set(_key "@KATANA_DEPLOY_KEY@|${_bin}")
set(_previous_programs "")
if(_build_tree AND EXISTS "${_stamp}")
    file(STRINGS "${_stamp}" _recorded)
    set(_recorded_key "")
    if(_recorded)
        list(POP_FRONT _recorded _recorded_key)
    endif()
    set(_current TRUE)
    if(NOT _recorded_key STREQUAL _key)
        set(_current FALSE)
        set(_reason "the link libraries or the deploy script changed")
    else()
        foreach(_record IN LISTS _recorded)
            if(_record MATCHES "^program=([^|]+)[|]")
                set(_name "${CMAKE_MATCH_1}")
                if(NOT _name IN_LIST _program_names AND EXISTS "${_bin}/${_name}")
                    list(APPEND _previous_programs "${_record}")
                endif()
            endif()
        endforeach()
    endif()
    if(_current AND (NOT IS_DIRECTORY "${_prefix}/share/proj"
       OR NOT IS_DIRECTORY "${_prefix}/share/gdal"
       OR NOT EXISTS "${_prefix}/etc/ssl/certs/ca-bundle.crt"))
        set(_current FALSE)
        set(_reason "runtime data is missing")
    endif()
    foreach(_record IN LISTS _program_records)
        if(_current AND NOT _record IN_LIST _recorded)
            set(_current FALSE)
            set(_reason "a program was linked or has not been deployed yet")
        endif()
    endforeach()
    foreach(_relative IN LISTS _recorded)
        if(NOT _current)
            break()
        endif()
        if(_relative MATCHES "^program=")
            continue()
        endif()
        if(NOT EXISTS "${_bin}/${_relative}")
            set(_current FALSE)
            set(_reason "${_relative} is missing")
            break()
        endif()
        _katana_source_of("${_relative}" _source)
        if(NOT _source STREQUAL "")
            file(TIMESTAMP "${_source}" _source_time "%s" UTC)
            file(TIMESTAMP "${_bin}/${_relative}" _deployed_time "%s" UTC)
            if(NOT _source_time STREQUAL _deployed_time)
                set(_current FALSE)
                set(_reason "${_relative} differs from ${_source}")
            endif()
        endif()
    endforeach()
    if(_current)
        return()
    endif()
    message(STATUS "Katana runtime: ${_reason}; redeploying into ${_bin}")
endif()
if(_build_tree)
    file(REMOVE "${_stamp}")
endif()

# A full build-tree deploy first brings every DLL already there up to date with
# the toolchain. The scan below cannot do it: it resolves a dependency BESIDE
# the program first, so a stale copy there is found, satisfies it, and is kept.
if(_build_tree)
    _katana_deployed_dlls(_existing)
    foreach(_relative IN LISTS _existing)
        _katana_source_of("${_relative}" _source)
        if(NOT _source STREQUAL "")
            get_filename_component(_directory "${_bin}/${_relative}" DIRECTORY)
            file(COPY "${_source}" DESTINATION "${_directory}")
        endif()
    endforeach()
endif()

# --- 1. Qt ------------------------------------------------------------------------
# windeployqt knows what no dependency scan can: the PLUGINS. katana.exe does
# not link qwindows.dll - Qt loads it at start-up by name - so an objdump of
# the executable never mentions it, and without it the application dies with
# "no Qt platform plugin could be initialized".
if("katana.exe" IN_LIST _program_names)
    if(NOT EXISTS "@KATANA_WINDEPLOYQT@")
        message(FATAL_ERROR "Katana deploy: windeployqt was not found; Qt's runtime and plugins cannot be bundled")
    endif()
    execute_process(
        COMMAND "@KATANA_WINDEPLOYQT@"
                --no-translations --no-system-d3d-compiler --no-opengl-sw
                --no-compiler-runtime --dir "${_bin}" "${_bin}/katana.exe"
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT "${_rc}" STREQUAL "0")
        message(FATAL_ERROR "windeployqt failed (${_rc}):\n${_out}\n${_err}")
    endif()
endif()

# windeployqt ships the platform plugin a desktop needs, qwindows.dll, and only
# that. `katana --plot` is a HEADLESS feature - it is what a build server or a
# scheduled job runs - and with QT_QPA_PLATFORM=offscreen and no qoffscreen.dll
# Qt does not fail: it opens a modal "no Qt platform plugin could be
# initialized" box and waits for a click that never comes. Found by this
# bundle's own smoke test hanging for ten minutes. Copied BEFORE the scan below
# so that its dependencies are gathered with everyone else's.
if("katana.exe" IN_LIST _program_names)
    if(NOT EXISTS "${_qt_plugins}/platforms/qoffscreen.dll")
        message(FATAL_ERROR "Katana deploy: ${_qt_plugins}/platforms/qoffscreen.dll was not found")
    endif()
    file(COPY "${_qt_plugins}/platforms/qoffscreen.dll" DESTINATION "${_bin}/platforms")
    if(NOT EXISTS "${_bin}/platforms/qwindows.dll")
        message(FATAL_ERROR "Katana deploy: windeployqt did not deploy platforms/qwindows.dll")
    endif()
endif()

# --- 2. Everything else that is loaded --------------------------------------------
# Scanned AFTER windeployqt, and over the plugins too, because a plugin has
# dependencies of its own that nothing else pulls in - qjpeg.dll needs
# libjpeg, and only qjpeg.dll does. The programs are the top-level ones: in
# the build tree, bin/tests and bin/benchmarks are not part of the product.
_katana_deployed_dlls(_library_names)
set(_libraries "")
foreach(_relative IN LISTS _library_names)
    list(APPEND _libraries "${_bin}/${_relative}")
endforeach()

# Explicit, because a script does not inherit the project's toolchain
# detection and the Windows default is dumpbin, which a MinGW machine lacks.
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "objdump")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")

# CONFLICTING_DEPENDENCIES_PREFIX, because a conflict here is normal and not an
# error. katana.exe finds Qt6Core.dll BESIDE ITSELF, where windeployqt has just
# put it; bin/platforms/qwindows.dll has no Qt6Core.dll beside it and finds the
# toolchain's copy instead. Same DLL, two paths - which CMake reports as a
# fatal "multiple conflicting paths" unless asked to collect them. They are
# handled below: whatever the bundle already has is left alone.
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${_executables}
    LIBRARIES ${_libraries}
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    CONFLICTING_DEPENDENCIES_PREFIX _conflict
    DIRECTORIES "${_bin}" "${_toolchain_bin}"
    # The operating system's own DLLs are not ours to ship: the API sets by
    # name, and anything that resolves into the Windows directory.
    PRE_EXCLUDE_REGEXES "^api-ms-" "^ext-ms-" "^hvsifiletrust" "^pdmutilities" "^wpaxholder"
    POST_EXCLUDE_REGEXES ".*[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*")

if(_unresolved)
    list(JOIN _unresolved "\n  " _text)
    message(FATAL_ERROR "Katana deploy: required DLLs were NOT found and cannot be bundled:\n  ${_text}\n"
                        "Install the matching runtime libraries in ${_toolchain_bin} and build again.")
endif()

set(_copied 0)
foreach(_dependency IN LISTS _resolved)
    get_filename_component(_name "${_dependency}" NAME)
    if(NOT EXISTS "${_bin}/${_name}")
        file(COPY "${_dependency}" DESTINATION "${_bin}")
        math(EXPR _copied "${_copied} + 1")
    endif()
endforeach()
# A conflicting name is one the bundle may or may not already hold. Where it
# does not, take the toolchain's copy - the only other place it can have come
# from, apart from the deployed directory itself.
foreach(_name IN LISTS _conflict_FILENAMES)
    if(NOT EXISTS "${_bin}/${_name}")
        foreach(_candidate IN LISTS _conflict_${_name})
            if(NOT EXISTS "${_bin}/${_name}" AND EXISTS "${_candidate}")
                file(COPY "${_candidate}" DESTINATION "${_bin}")
                math(EXPR _copied "${_copied} + 1")
            endif()
        endforeach()
    endif()
endforeach()
message(STATUS "Katana deploy: ${_copied} runtime libraries copied into ${_bin}")

# --- 3. Data that GDAL and PROJ read at run time ------------------------------------
# proj.db is a DATA file, so no dependency scan finds it, and without it every
# reprojection fails with "cannot find proj.db". PROJ looks beside its own DLL
# at ../share/proj, which is exactly where this puts it; GDAL's support files
# (header.dxf, which every DXF export is built from) are found the same way by
# locateGdalData in src/katana_io/gdal_adapter.cpp.
foreach(_data proj gdal)
    if(IS_DIRECTORY "${_toolchain_bin}/../share/${_data}")
        file(COPY "${_toolchain_bin}/../share/${_data}" DESTINATION "${_prefix}/share")
    elseif(_data STREQUAL "proj" AND NOT _build_tree)
        # A package without proj.db cannot name a coordinate system, and the smoke
        # test of INFO on a UTM raster would not notice (docs/release.md): a package
        # is not made without it. The build tree only warns, as it always did.
        message(FATAL_ERROR "Katana deploy: ${_toolchain_bin}/../share/proj was not found; "
                            "a package without PROJ's database cannot be made")
    else()
        message(WARNING "Katana deploy: ${_toolchain_bin}/../share/${_data} was not found; "
                        "the bundle will lack it")
    endif()
endforeach()
if(NOT _build_tree AND NOT EXISTS "${_prefix}/share/proj/proj.db")
    message(FATAL_ERROR "Katana deploy: ${_prefix}/share/proj/proj.db is not in the package; "
                        "the toolchain's share/proj holds no proj.db")
endif()
# The certificates every HTTPS request is checked against. libcurl - which
# GDAL fetches through: GIS > Online Data, /vsicurl/ - reads them from a file
# found, like proj.db, RELATIVE TO ITS OWN DLL: <bin>/../etc/ssl/certs/
# ca-bundle.crt. Without it every https:// request failed before reaching the
# server ("error adding trust anchors from file"), and it went unseen because
# the tests load libcurl from the toolchain, whose bundle is in place.
# file(COPY) re-copies it when the toolchain's ca-certificates update.
set(_ca_bundle "${_toolchain_bin}/../etc/ssl/certs/ca-bundle.crt")
if(EXISTS "${_ca_bundle}")
    file(COPY "${_ca_bundle}" DESTINATION "${_prefix}/etc/ssl/certs")
else()
    message(WARNING "Katana deploy: ${_ca_bundle} was not found; "
                    "no https:// request will be trusted")
endif()

# --- 4. The build tree records what it now holds --------------------------------------
# Written LAST, so a deploy that failed part-way leaves no stamp and the next
# build tries again rather than trusting a half-made bin/.
if(_build_tree)
    _katana_deployed_dlls(_now)
    list(APPEND _now ${_previous_programs} ${_program_records})
    list(JOIN _now "\n" _lines)
    file(WRITE "${_stamp}" "${_key}\n${_lines}\n")
endif()
