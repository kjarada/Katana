;--------------------------------
; Installer section

Section "-Core installation"
  Call CheckInstallFolder

  ; A copy of Katana that is already in this folder and was not uninstalled first (the answer
  ; at the start was No, or the registry does not know of it). What goes in below is this
  ; version, so the updater's record of the version the folder holds goes: left behind, it
  ; would still name the old one. So does the working folder of an update that was cut short:
  ; its recovery, at the next start, would put files of the old version back over the new
  ; ones (docs/update.md). The installed manifest stays: it is how the next update, and the
  ; uninstaller, find the files an earlier update added. install.json is what says the folder
  ; holds a packaged Katana, and nothing is touched in a folder without it.
  IfFileExists "$INSTDIR\share\katana\install.json" 0 previous_copy_done
    Delete "$INSTDIR\share\katana\installed.json"
    RMDir /r "$INSTDIR\.update"
  previous_copy_done:

  ; The tree CPack staged: every file of the package, in the folders the programs expect.
  SetOutPath "$INSTDIR"
  @CPACK_NSIS_EXTRA_PREINSTALL_COMMANDS@
  @CPACK_NSIS_FULL_INSTALL@

  ; The folder, which the updater reads to tell an installed copy from an unpacked archive.
  WriteRegStr HKCU "${KATANA_PRODUCT_KEY}" "" "$INSTDIR"

  ; The uninstaller, and the entry in Settings > Apps that runs it.
  WriteUninstaller "$INSTDIR\@CPACK_NSIS_UNINSTALL_NAME@.exe"
  WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "DisplayName" "@CPACK_NSIS_DISPLAY_NAME@"
  WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "DisplayVersion" "@CPACK_PACKAGE_VERSION@"
  WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "Publisher" "@CPACK_PACKAGE_VENDOR@"
  WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "UninstallString" '"$INSTDIR\@CPACK_NSIS_UNINSTALL_NAME@.exe"'
  WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\@CPACK_NSIS_INSTALLED_ICON_NAME@"
  WriteRegDWORD HKCU "${KATANA_UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${KATANA_UNINSTALL_KEY}" "NoRepair" 1
  !if "@CPACK_NSIS_HELP_LINK@" != ""
    WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "HelpLink" "@CPACK_NSIS_HELP_LINK@"
  !endif
  !if "@CPACK_NSIS_URL_INFO_ABOUT@" != ""
    WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "URLInfoAbout" "@CPACK_NSIS_URL_INFO_ABOUT@"
  !endif
  !if "@CPACK_NSIS_CONTACT@" != ""
    WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "Contact" "@CPACK_NSIS_CONTACT@"
  !endif

  ; The size Settings > Apps shows, in kilobytes, of what is in the folder now.
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKCU "${KATANA_UNINSTALL_KEY}" "EstimatedSize" "$0"

  !insertmacro MUI_STARTMENU_WRITE_BEGIN Application

  ; The shortcuts, in the current user's Start menu.
  CreateDirectory "$SMPROGRAMS\$STARTMENU_FOLDER"
@CPACK_NSIS_CREATE_ICONS@
@CPACK_NSIS_CREATE_ICONS_EXTRA@
  CreateShortCut "$SMPROGRAMS\$STARTMENU_FOLDER\Uninstall.lnk" "$INSTDIR\@CPACK_NSIS_UNINSTALL_NAME@.exe"

  WriteRegStr HKCU "${KATANA_UNINSTALL_KEY}" "StartMenu" "$STARTMENU_FOLDER"

  !insertmacro MUI_STARTMENU_WRITE_END

@CPACK_NSIS_EXTRA_INSTALL_COMMANDS@

SectionEnd

;--------------------------------
; Uninstaller

; Deletes one file a release lists, and the folders that leaves empty.
;
; Push the path as the manifest writes it, with \ for /, relative to the install folder. It
; is the same rule as the updater's (include/katana/update/paths.hpp) in the part that matters
; here: the first folder is one a release installs into, and no component is "." or "..", so a
; manifest that has been tampered with cannot send the delete outside the folder. A path that
; fails is skipped, not an error: what the uninstaller cannot vouch for it leaves.
Function un.DeleteListedFile
  Exch $R0
  Push $R1
  Push $R2

  StrCpy $R1 $R0 4
  StrCmp $R1 "bin\" listed_folder_ok
  StrCmp $R1 "etc\" listed_folder_ok
  StrCmp $R1 "lib\" listed_folder_ok
  StrCpy $R1 $R0 6
  StrCmp $R1 "share\" listed_folder_ok listed_done
  listed_folder_ok:

  ; With a \ added at both ends every component, the first and the last too, has a \ on each
  ; side, and the rules are three substrings.
  Push "\$R0\"
  Push "\..\"
  Call un.StrStr
  Pop $R1
  StrCmp $R1 "" 0 listed_done
  Push "\$R0\"
  Push "\.\"
  Call un.StrStr
  Pop $R1
  StrCmp $R1 "" 0 listed_done
  Push "\$R0\"
  Push "\\"
  Call un.StrStr
  Pop $R1
  StrCmp $R1 "" 0 listed_done

  Delete "$INSTDIR\$R0"

  ; Each folder above it that is now empty, innermost first, up to and including the first
  ; level (bin, share ...). Not the install folder itself: the uninstaller removes that last,
  ; and only if nothing else is in it.
  listed_climb:
    StrLen $R1 $R0
    listed_find_separator:
      IntOp $R1 $R1 - 1
      IntCmp $R1 0 listed_done listed_done listed_test_character
      listed_test_character:
      StrCpy $R2 $R0 1 $R1
      StrCmp $R2 "\" 0 listed_find_separator
    StrCpy $R0 $R0 $R1
    ClearErrors
    RMDir "$INSTDIR\$R0"
    IfErrors listed_done listed_climb

  listed_done:
  Pop $R2
  Pop $R1
  Pop $R0
FunctionEnd

; Deletes every file the installed manifest lists. share\katana\installed.manifest.json is the
; signed manifest of the version the updater last installed (docs/update.md): it names every
; file that version has, the ones this installer did not put down included. Absent on a copy
; that has never been updated, and then the installer's own list is all there is.
;
; JSON is read as the bytes it is, with a state machine, because NSIS has no parser and a line
; can be longer than its strings. It looks for the member "path":" , which in a manifest is the
; name of one file, and reads up to the closing quote. The producer escapes nothing in a path
; (printable ASCII, none of \ " : * ? < > |, paths.hpp), so a byte outside that set, or a
; path longer than 240 characters, marks the entry as one this will not touch.
Function un.DeleteManifestFiles
  Push $0
  Push $1
  Push $2
  Push $3
  Push $4
  Push $5
  Push $6

  ClearErrors
  FileOpen $0 "$INSTDIR\share\katana\installed.manifest.json" r
  IfErrors manifest_done

  ; $2: how many characters of  "path":"  have matched; 8 means inside the value.
  StrCpy $2 0
  manifest_next_byte:
    FileReadByte $0 $1
    IfErrors manifest_close
    StrCmp $2 8 manifest_in_path
    IntFmt $4 "%c" $1
    StrCpy $5 '"path":"' 1 $2
    StrCmpS $4 $5 manifest_matched
    StrCpy $2 0
    StrCmp $1 34 0 manifest_next_byte
    StrCpy $2 1
    Goto manifest_next_byte
  manifest_matched:
    IntOp $2 $2 + 1
    StrCmp $2 8 0 manifest_next_byte
    StrCpy $3 ""
    StrCpy $6 0
    Goto manifest_next_byte

  manifest_in_path:
    StrCmp $1 34 manifest_path_end
    StrCmp $6 1 manifest_next_byte
    IntCmp $1 32 manifest_character_ok manifest_bad_byte manifest_character_ok
    manifest_character_ok:
    IntCmp $1 126 manifest_character_ok_too manifest_character_ok_too manifest_bad_byte
    manifest_character_ok_too:
    StrCmp $1 92 manifest_bad_byte
    StrCmp $1 58 manifest_bad_byte
    StrCmp $1 42 manifest_bad_byte
    StrCmp $1 63 manifest_bad_byte
    StrCmp $1 60 manifest_bad_byte
    StrCmp $1 62 manifest_bad_byte
    StrCmp $1 124 manifest_bad_byte
    ; 239 characters or fewer so far leaves room for this one; a 241st is refused.
    StrLen $5 $3
    IntCmp $5 239 0 0 manifest_bad_byte
    StrCmp $1 47 0 manifest_append
    StrCpy $3 "$3\"
    Goto manifest_next_byte
    manifest_append:
    IntFmt $4 "%c" $1
    StrCpy $3 "$3$4"
    Goto manifest_next_byte
  manifest_bad_byte:
    StrCpy $6 1
    Goto manifest_next_byte

  manifest_path_end:
    StrCpy $2 0
    StrCmp $6 1 manifest_next_byte
    StrCmp $3 "" manifest_next_byte
    Push $3
    Call un.DeleteListedFile
    Goto manifest_next_byte

  manifest_close:
    FileClose $0
  manifest_done:
  Pop $6
  Pop $5
  Pop $4
  Pop $3
  Pop $2
  Pop $1
  Pop $0
FunctionEnd

; Removes what the updater leaves outside the install folder: the files it downloaded and
; the copies of its helper it ran. Not state.json, the person's choices about updating
; (automatic check, skipped version), which are settings like the ones in the registry that
; are kept too. Whatever is in the folder, a download or a copy of the helper, is the
; updater's, so everything else in it goes, recursively.
Function un.RemoveUpdateState
  Push $0
  Push $1
  FindFirst $0 $1 "${KATANA_UPDATE_STATE}\*.*"
  state_next:
    StrCmp $1 "" state_done
    StrCmp $1 "." state_skip
    StrCmp $1 ".." state_skip
    StrCmp $1 "state.json" state_skip
    IfFileExists "${KATANA_UPDATE_STATE}\$1\*.*" 0 state_file
      RMDir /r "${KATANA_UPDATE_STATE}\$1"
      Goto state_skip
    state_file:
      Delete "${KATANA_UPDATE_STATE}\$1"
    state_skip:
    FindNext $0 $1
    Goto state_next
  state_done:
  FindClose $0
  ; The folders above, if that left them empty.
  RMDir "${KATANA_UPDATE_STATE}"
  RMDir "$LOCALAPPDATA\Katana"
  Pop $1
  Pop $0
FunctionEnd

Section "Uninstall"
  ; Everything below is relative to the folder the uninstaller was started for; without it
  ; "$INSTDIR\.update" would name a folder at the top of a drive.
  StrCmp $INSTDIR "" 0 uninstall_folder_known
    Abort "Katana's folder is not known, so nothing was removed."
  uninstall_folder_known:

  ; The Start menu folder, before the registry that names it goes.
  !insertmacro MUI_STARTMENU_GETFOLDER Application $MUI_TEMP
  ReadRegStr $START_MENU HKCU "${KATANA_UNINSTALL_KEY}" "StartMenu"
  StrCmp $MUI_TEMP "" 0 +2
    StrCpy $MUI_TEMP "$START_MENU"

@CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS@

  ; The files this installer put down (CPack's list)...
@CPACK_NSIS_DELETE_FILES@

  ; ...the files an update added or replaced (the installed manifest's list)...
  Call un.DeleteManifestFiles

  ; ...the updater's own records and its working folder. The files in .update are its
  ; journals and the old and new copies of files in the middle of a swap: nothing of the
  ; person's, and not worth keeping once the program they belong to is gone.
  Delete "$INSTDIR\share\katana\installed.json"
  Delete "$INSTDIR\share\katana\installed.manifest.json"
  Delete "$INSTDIR\share\katana\installed.manifest.json.sig"
  RMDir /r "$INSTDIR\.update"
  Call un.RemoveUpdateState
  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\RunOnce" "KatanaUpdateRecover"

  ; Folders, now that they can be empty. RMDir without /r removes an empty folder and no other.
@CPACK_NSIS_DELETE_DIRECTORIES@

  ; The shortcuts, in the folder the installer made. If it made none (the person chose not to
  ; have any) there is no folder to name, and the clean-up below, which removes empty folders
  ; from that one upwards, would start at the Start menu's own.
  StrCmp $MUI_TEMP "" startMenuDeleteLoopDone
  Delete "$SMPROGRAMS\$MUI_TEMP\Uninstall.lnk"
@CPACK_NSIS_DELETE_ICONS@
@CPACK_NSIS_DELETE_ICONS_EXTRA@
  StrCpy $MUI_TEMP "$SMPROGRAMS\$MUI_TEMP"
  startMenuDeleteLoop:
    ClearErrors
    RMDir $MUI_TEMP
    GetFullPathName $MUI_TEMP "$MUI_TEMP\.."
    IfErrors startMenuDeleteLoopDone
    StrCmp "$MUI_TEMP" "$SMPROGRAMS" startMenuDeleteLoopDone startMenuDeleteLoop
  startMenuDeleteLoopDone:

  ; The uninstaller itself, the entry in Settings > Apps, the folder (only if it is empty:
  ; a file the person put in it stays, and so does the folder), and the rest of the registry.
  ; The settings under HKCU\Software\Katana are the program's and are kept.
  Delete "$INSTDIR\@CPACK_NSIS_UNINSTALL_NAME@.exe"
  DeleteRegKey HKCU "${KATANA_UNINSTALL_KEY}"
  RMDir "$INSTDIR"
  DeleteRegKey HKCU "${KATANA_PRODUCT_KEY}"
  DeleteRegKey /ifempty HKCU "Software\@CPACK_PACKAGE_VENDOR@"
SectionEnd

;--------------------------------
; Installer start

Function .onInit
  ; Per user and nothing else: the Start menu and the registry below are the current user's.
  SetShellVarContext current

  ; /D=C:\Folder\ leaves the backslash on; the folder is recorded without it.
  StrCpy $0 "$INSTDIR" 1 -1
  StrCmp $0 "\" 0 +2
    StrCpy $INSTDIR "$INSTDIR" -1

  !if "@CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL@" == "ON"
  ; A copy of Katana already installed is uninstalled first, which is also the way to repair
  ; one: the files, the records and anything an update left are all removed, then the new
  ; ones are put down. A silent run does so without asking.
  ReadRegStr $0 HKCU "${KATANA_UNINSTALL_KEY}" "UninstallString"
  StrCmp $0 "" onInitDone

  ; UninstallString is quoted; the path is wanted without the quotes.
  StrCpy $2 $0 1 0
  StrCmp $2 "$\"" 0 +2
  StrCpy $0 $0 "" 1
  StrCpy $2 $0 1 -1
  StrCmp $2 "$\"" 0 +2
  StrCpy $0 $0 -1

  ; An entry whose uninstaller is no longer there is no installed copy: the folder was deleted
  ; by hand, which is easy to do in one's own profile, and the entry in Settings > Apps stayed
  ; behind. There is nothing to ask about and nothing to run, and trying to run it would fail
  ; and stop this install, every time, and a silent one with no way round it. The install goes
  ; ahead and writes the entry anew.
  IfFileExists "$0" 0 onInitDone

  ReadRegStr $1 HKCU "${KATANA_UNINSTALL_KEY}" "DisplayName"
  MessageBox MB_YESNOCANCEL|MB_ICONEXCLAMATION \
  "$1 is already installed.$\r$\n$\r$\nDo you want to uninstall the old version before installing the new one?" \
  /SD IDYES IDYES onInitUninstall IDNO onInitDone
  Abort

  onInitUninstall:
  ClearErrors
  StrLen $2 "\@CPACK_NSIS_UNINSTALL_NAME@.exe"
  StrCpy $3 $0 -$2
  ; _?= runs the uninstaller where it is, not from a copy, so that this waits for it.
  ExecWait '"$0" /S _?=$3'

  IfErrors onInitUninstallFailed onInitDone
  onInitUninstallFailed:
  MessageBox MB_OK|MB_ICONSTOP "Uninstall failed." /SD IDOK
  Abort

  onInitDone:
  !endif
FunctionEnd
