; Katana's Windows installer: PER-USER. CPack finds this file before its own
; NSIS.template.in because cmake/ is on CPACK_MODULE_PATH (cmake/KatanaPackaging.cmake).
;
; What it is and why (docs/release.md, "The Windows installer"; docs/update.md):
;
;   * It installs for the person who runs it, into %LOCALAPPDATA%\Programs\Katana by default
;     (any folder they can write to), and asks for no administrator rights. The registry is
;     touched under HKCU only. The updater (docs/update.md) replaces files inside that folder
;     as the same user, and a per-user install is what lets it do so without a UAC prompt.
;   * What it writes where, and the updater reads (include/katana/update/registry.hpp):
;       HKCU\Software\Jarada\Katana                                  the install folder
;       HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\Katana
;                                          DisplayName DisplayVersion Publisher UninstallString
;                                          InstallLocation DisplayIcon EstimatedSize NoModify NoRepair
;   * Its uninstaller removes the files this installer put down, AND every file the installed
;     manifest lists (share\katana\installed.manifest.json: an update adds files this uninstaller
;     was not built knowing), AND the updater's records and its working folder .update. Of the
;     folder it removes nothing else: a file the user put there stays, and so does the folder. The
;     install folder is never removed recursively, because the user may have chosen a folder with
;     other things in it. Outside it, what the updater staged under %LOCALAPPDATA%\Katana\update
;     goes (not state.json, the person's choices), and the registry keys and shortcuts above.
;   * Put down over a copy that was not uninstalled first, it removes the updater's record of that
;     copy's version and the working folder of an update that was cut short (the installer's own
;     section says why), and it stops at a file that is in use, never skips it.
;   * A copy that is already installed is uninstalled first (asked; a silent run does not ask).
;     An entry in Settings > Apps whose uninstaller is no longer there, because the folder was
;     deleted by hand, is no such copy, and the install goes ahead.
;   * /S (silent) and /D=<folder> work as in any NSIS installer; README.md documents them. A silent
;     run never waits for an answer: every MessageBox has a /SD default.
;
; Taken from CPack's template (CMake 4.x) and cut down: its components, "add to PATH" and
; "install options" page are gone. Katana has no components and has never changed PATH, the
; stock PATH code wrote machine-wide settings, and the options page offered those choices. The
; variables CPack fills in (@CPACK_NSIS_FULL_INSTALL@ and the rest) are used as it uses them,
; so cpack's other generator settings still work. tests/update/check_nsis_script.cmake holds
; the text this produces to the rules above; keep it in step.
;
; Comments are whole lines only, and none names a registry hive other than HKCU: that check
; reads the instructions, but a reader should not have to tell them apart. None ends in a
; backslash either: NSIS continues a comment onto the next line as it does a command, and the
; instruction there would be part of the comment (the check refuses such a line). Block
; comments are not used. Conditions are of two kinds, the test for MSYS2's NSIS, which holds
; the Target line alone, and comparisons of a value CPack filled in with a literal, and none
; is inside another: the check reads what NSIS compiles, and refuses what it cannot tell.

;--------------------------------
; Values CPack supplies

  !define VERSION "@CPACK_PACKAGE_VERSION@"
  !define PATCH  "@CPACK_PACKAGE_VERSION_PATCH@"
  !define INST_DIR "@CPACK_TEMPORARY_DIRECTORY@"

  !define KATANA_PRODUCT_KEY "Software\@CPACK_PACKAGE_VENDOR@\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@"
  !define KATANA_UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@"
  !define KATANA_UPDATE_STATE "$LOCALAPPDATA\Katana\update"

;--------------------------------
; Variables

  Var MUI_TEMP
  Var STARTMENU_FOLDER
  Var START_MENU

;--------------------------------
; Which NSIS this is. The official release (and Chocolatey's, which the ARM64 job uses) builds an
; x86 installer and keeps its plugins in Plugins\x86-unicode: the default, nothing to say. MSYS2's
; NSIS 3.13 is built for x86-64 only and keeps them in Plugins\unicode, and for it the default
; target finds no plugin at all (CPack's own template stops at "Plugin not found, cannot call
; nsDialogs::Create"), so it is told to make the x86-64 installer it has stubs for.
  !if /FileExists "${NSISDIR}\Plugins\unicode\nsDialogs.dll"
    Target amd64-unicode
  !endif

; Text is UTF-16: the default folder is under the user's own profile, whose name can hold any
; character, and an ANSI installer would turn the ones its code page lacks into question marks.

  Unicode true

;--------------------------------
; Modern UI

  !include "MUI2.nsh"
  !include "FileFunc.nsh"
  !insertmacro GetSize

;--------------------------------
; General

  Name "@CPACK_NSIS_PACKAGE_NAME@"
  OutFile "@CPACK_TOPLEVEL_DIRECTORY@/@CPACK_OUTPUT_FILE_NAME@"

  ; %LOCALAPPDATA%\Programs\Katana unless CPACK_NSIS_INSTALL_ROOT says otherwise. A copy that is
  ; already installed is offered again, so that a reinstall goes where the first install went;
  ; /D= beats both.
  InstallDir "@CPACK_NSIS_INSTALL_ROOT@\@CPACK_PACKAGE_INSTALL_DIRECTORY@"
  InstallDirRegKey HKCU "${KATANA_PRODUCT_KEY}" ""

  SetCompressor @CPACK_NSIS_COMPRESSOR@

  ; No elevation, no prompt: everything below is the user's own.
  RequestExecutionLevel user

  ; A file that cannot be written, which is what a running program of Katana's is, stops the
  ; install: Retry or Cancel, and a silent run fails. NSIS's default lets the file be skipped,
  ; and that leaves the old program among the new libraries.
  AllowSkipFiles off

@CPACK_NSIS_DEFINES@
@CPACK_NSIS_MANIFEST_DPI_AWARE_CODE@
@CPACK_NSIS_BRANDING_TEXT_CODE@
@CPACK_NSIS_CRC_CHECK_CODE@

;--------------------------------
; Interface settings

  !define MUI_HEADERIMAGE
  !define MUI_ABORTWARNING

@CPACK_NSIS_INSTALLER_MUI_ICON_CODE@
@CPACK_NSIS_INSTALLER_ICON_CODE@
@CPACK_NSIS_INSTALLER_MUI_WELCOMEFINISH_CODE@
@CPACK_NSIS_INSTALLER_MUI_UNWELCOMEFINISH_CODE@
@CPACK_NSIS_INSTALLER_MUI_FINISHPAGE_RUN_CODE@

;--------------------------------
; String search, for the uninstaller's checks of a manifest path.
;
; Push the string to search in, then the string to search for, Call un.StrStr, Pop the result:
; the rest of the first string from the first match, or "" for none.

Function un.StrStr
  Exch $R1
  Exch
  Exch $R2
  Push $R3
  Push $R4
  Push $R5
  StrLen $R3 $R1
  StrCpy $R4 0
  strstr_loop:
    StrCpy $R5 $R2 $R3 $R4
    StrCmp $R5 $R1 strstr_done
    StrCmp $R5 "" strstr_done
    IntOp $R4 $R4 + 1
    Goto strstr_loop
  strstr_done:
  StrCpy $R1 $R2 "" $R4
  Pop $R5
  Pop $R4
  Pop $R3
  Pop $R2
  Exch $R1
FunctionEnd

;--------------------------------
; A folder the installer cannot write to is refused up front, with the reason, rather than
; failing half way through the files. Run when the folder page is left and again at the start
; of the install, which is where a silent run (no page) meets it.

Function CheckInstallFolder
  Push $0
  ; No folder at all is refused like one that cannot be written to: every path below starts
  ; with it, and without it would start at the top of a drive.
  StrCmp $INSTDIR "" folder_not_writable
  ClearErrors
  CreateDirectory "$INSTDIR"
  FileOpen $0 "$INSTDIR\katana-write-test.tmp" w
  IfErrors folder_not_writable
  FileClose $0
  Delete "$INSTDIR\katana-write-test.tmp"
  Pop $0
  Return
  folder_not_writable:
    MessageBox MB_OK|MB_ICONEXCLAMATION "Katana is installed for your account only, so it needs a folder you can write to.$\r$\n$\r$\n$INSTDIR is not one. Choose another folder." /SD IDOK
    Pop $0
    Abort
FunctionEnd

;--------------------------------
; Pages

  @CPACK_NSIS_INSTALLER_WELCOME_TITLE_CODE@
  @CPACK_NSIS_INSTALLER_WELCOME_TITLE_3LINES_CODE@
  !insertmacro MUI_PAGE_WELCOME

  ; The GNU General Public License asks nobody to accept it to run a program, so this page is
  ; for reading: it says so, and its button is Next, not I Agree (the page the NSIS manual
  ; shows for a program under the GPL). What it shows is CPACK_RESOURCE_FILE_LICENSE, made by
  ; cmake/KatanaPackaging.cmake from LICENSE and ADDITIONAL_TERMS.md. A silent install
  ; (/S, the deployment scripts and the release smoke test) shows no page.
  !define MUI_PAGE_HEADER_SUBTEXT "Please review the licence of Katana before installing it."
  !define MUI_LICENSEPAGE_TEXT_TOP "Katana is free software. Scroll down to read the licence and the additional terms."
  !define MUI_LICENSEPAGE_TEXT_BOTTOM "You do not have to accept these terms to use Katana. They tell you what you are free to do with it, and what you are asked to keep. Click Next to continue."
  !define MUI_LICENSEPAGE_BUTTON "$(^NextBtn)"
  @CPACK_NSIS_LICENSE_PAGE@

  !define MUI_PAGE_CUSTOMFUNCTION_LEAVE CheckInstallFolder
  !insertmacro MUI_PAGE_DIRECTORY

  ; Where the Start menu folder's name is kept, so that the uninstaller finds it.
  !define MUI_STARTMENUPAGE_REGISTRY_ROOT "HKCU"
  !define MUI_STARTMENUPAGE_REGISTRY_KEY "${KATANA_PRODUCT_KEY}"
  !define MUI_STARTMENUPAGE_REGISTRY_VALUENAME "Start Menu Folder"
  !define MUI_STARTMENUPAGE_DEFAULTFOLDER "@CPACK_PACKAGE_INSTALL_DIRECTORY@"
  !insertmacro MUI_PAGE_STARTMENU Application $STARTMENU_FOLDER

  !insertmacro MUI_PAGE_INSTFILES
  @CPACK_NSIS_INSTALLER_FINISH_TITLE_CODE@
  @CPACK_NSIS_INSTALLER_FINISH_TITLE_3LINES_CODE@
  !insertmacro MUI_PAGE_FINISH

  !insertmacro MUI_UNPAGE_CONFIRM
  !insertmacro MUI_UNPAGE_INSTFILES

